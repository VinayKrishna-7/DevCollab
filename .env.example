# DevCollab Environment Configuration Example
# Copy this file to server/.env and adjust values for your environment.

PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/devcollab?schema=public"

# Session & Security Secrets
SESSION_SECRET="replace_with_a_long_random_session_secret_key"
COOKIE_SECRET="replace_with_a_long_random_cookie_signing_secret"

# Development Seed Admin Account (used during seed)
DEV_ADMIN_EMAIL="admin@devcollab.io"
DEV_ADMIN_USERNAME="admin"
DEV_ADMIN_PASSWORD="DevCollabAdmin2026!"
DEV_ADMIN_NAME="DevCollab Administrator"
